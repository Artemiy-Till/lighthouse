{
  "name": "max-travel-marketplace",
  "version": "0.0.0",
  "private": true,
  "description": "MAX Mini App marketplace for tours and local experiences",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.15 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm db:generate && pnpm --recursive --if-present build",
    "dev": "pnpm --parallel --filter @marketplace/api --filter @marketplace/web dev",
    "dev:api": "pnpm --filter @marketplace/api dev",
    "dev:web": "pnpm --filter @marketplace/web dev",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm --recursive --if-present test",
    "test:coverage": "pnpm --recursive --if-present test:coverage",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.5",
    "dotenv": "17.4.2",
    "eslint": "10.0.1",
    "globals": "17.12.0",
    "prettier": "3.9.7",
    "prisma": "7.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
