# Public domain must point to this server, and inbound ports 80 and 443 must be open.
APP_DOMAIN=app.example.ru

# Use a strong password containing URL-safe characters (letters and numbers).
POSTGRES_PASSWORD=replace-with-a-long-random-secret

# Required for MAX bot integration.
MAX_BOT_TOKEN=replace-with-the-MAX-bot-token

# Required only if guides need to upload photos. This is currently a Vercel Blob token.
BLOB_READ_WRITE_TOKEN=
