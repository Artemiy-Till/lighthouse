NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public

# Comma-separated browser origins allowed to call the API.
# In production, set this to the HTTPS origin serving the web app.
CORS_ORIGINS=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173

# Server-side only. Never expose this value through a VITE_* variable.
MAX_BOT_TOKEN=
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_API_TIMEOUT_MS=5000

# Public frontend setting. This is an API URL, not a secret.
VITE_API_BASE_URL=http://localhost:3000

# Optional locally. Required for guide photo uploads in production.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_ENDPOINT=https://storage.yandexcloud.net
OBJECT_STORAGE_REGION=ru-central1
