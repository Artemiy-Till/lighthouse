NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public

# Comma-separated browser origins allowed to call the API.
# Production defaults to https://lighthouse-api-one.vercel.app when empty.
CORS_ORIGINS=http://localhost:5173

# Server-side only. Never expose this value through a VITE_* variable.
MAX_BOT_TOKEN=
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_API_TIMEOUT_MS=5000

# Public frontend setting. This is an API URL, not a secret.
VITE_API_BASE_URL=http://localhost:3000

# Required only for uploading guide photos to Vercel Blob.
BLOB_READ_WRITE_TOKEN=
