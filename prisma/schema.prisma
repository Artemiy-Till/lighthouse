generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model GuideProfile {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  maxUserId   String                @unique @map("max_user_id")
  maxUsername String?               @map("max_username")
  displayName String                @map("display_name") @db.VarChar(80)
  bio         String                @db.VarChar(1000)
  photoUrl    String?               @map("photo_url")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime              @default(now()) @map("updated_at") @db.Timestamptz
  experiences PublishedExperience[]

  @@map("guide_profiles")
}

model PublishedExperience {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guideId         String       @map("guide_id") @db.Uuid
  guide           GuideProfile @relation(fields: [guideId], references: [id], onDelete: Cascade)
  cityId          String       @map("city_id") @db.VarChar(40)
  category        String       @db.VarChar(40)
  title           String       @db.VarChar(120)
  intro           String       @db.VarChar(240)
  description     String       @db.VarChar(3000)
  durationMinutes Int          @map("duration_minutes")
  format          String       @db.VarChar(80)
  groupSize       Int          @map("group_size")
  childrenPolicy  String       @map("children_policy") @db.VarChar(160)
  meetingPoint    String       @map("meeting_point") @db.VarChar(240)
  priceRub        Int          @map("price_rub")
  photoUrls       String[]     @default([]) @map("photo_urls")
  status          String       @default("published") @db.VarChar(20)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @default(now()) @map("updated_at") @db.Timestamptz

  @@index([cityId, status, createdAt(sort: Desc)], map: "published_experiences_city_status_created_idx")
  @@map("published_experiences")
}

model ExperienceBooking {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  maxUserId     String            @map("max_user_id")
  maxUsername   String?           @map("max_username")
  guestName     String?           @map("guest_name") @db.VarChar(160)
  experienceId  String            @map("experience_id")
  title         String            @db.VarChar(120)
  cityId        String            @map("city_id") @db.VarChar(40)
  imageUrl      String            @map("image_url")
  meetingPoint  String            @map("meeting_point") @db.VarChar(240)
  bookingDate   DateTime          @map("booking_date") @db.Date
  bookingTime   DateTime          @map("booking_time") @db.Time
  participants  Int
  unitPriceRub  Int               @map("unit_price_rub")
  totalPriceRub Int               @map("total_price_rub")
  status        String            @default("confirmed") @db.VarChar(20)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime          @default(now()) @map("updated_at") @db.Timestamptz
  review        ExperienceReview?

  @@index([maxUserId, bookingDate(sort: Desc), createdAt(sort: Desc)], map: "experience_bookings_user_date_idx")
  @@map("experience_bookings")
}

model ExperienceReview {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId      String            @unique @map("booking_id") @db.Uuid
  booking        ExperienceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  maxUserId      String            @map("max_user_id")
  experienceId   String            @map("experience_id")
  authorName     String            @map("author_name") @db.VarChar(160)
  authorPhotoUrl String?           @map("author_photo_url")
  rating         Int
  comment        String            @db.VarChar(1000)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @default(now()) @map("updated_at") @db.Timestamptz

  @@index([experienceId, createdAt(sort: Desc)], map: "experience_reviews_experience_created_idx")
  @@map("experience_reviews")
}

model ExperienceBookingSlot {
  experienceId String   @map("experience_id")
  bookingDate  DateTime @map("booking_date") @db.Date
  bookingTime  DateTime @map("booking_time") @db.Time
  capacity     Int
  booked       Int      @default(0)
  status       String   @default("scheduled") @db.VarChar(20)

  @@id([experienceId, bookingDate, bookingTime])
  @@map("experience_booking_slots")
}
