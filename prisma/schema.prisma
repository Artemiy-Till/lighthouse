generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model GuideProfile {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  maxUserId   String                @unique @map("max_user_id")
  displayName String                @map("display_name") @db.VarChar(80)
  bio         String                @db.VarChar(1000)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime              @default(now()) @map("updated_at") @db.Timestamptz
  experiences PublishedExperience[]

  @@map("guide_profiles")
}

model PublishedExperience {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guideId         String       @map("guide_id") @db.Uuid
  guide           GuideProfile @relation(fields: [guideId], references: [id], onDelete: Cascade)
  cityId          String       @map("city_id") @db.VarChar(40)
  category        String       @db.VarChar(40)
  title           String       @db.VarChar(120)
  intro           String       @db.VarChar(240)
  description     String       @db.VarChar(3000)
  durationMinutes Int          @map("duration_minutes")
  format          String       @db.VarChar(80)
  groupSize       Int          @map("group_size")
  childrenPolicy  String       @map("children_policy") @db.VarChar(160)
  meetingPoint    String       @map("meeting_point") @db.VarChar(240)
  priceRub        Int          @map("price_rub")
  status          String       @default("published") @db.VarChar(20)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @default(now()) @map("updated_at") @db.Timestamptz

  @@index([cityId, status, createdAt(sort: Desc)], map: "published_experiences_city_status_created_idx")
  @@map("published_experiences")
}
